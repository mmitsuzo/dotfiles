# this script need to be read from ${HOME}/.bashrc using source or '.' command

export LANG=en_US.UTF-8

# add local PATHs
for dir in \
	"${HOME}/.local/bin" \
	"${HOME}/.local/src/node-v26.13.1-win-x64"
do
	if [ -d "${dir}" ]; then
		case ":${PATH}:" in
			*":${dir}:"*)
				;;
			*)
				PATH="${PATH}:${dir}"
				;;
		esac
	fi
done
export PATH

